# ============ 会话密钥 ============
# 必填。生成方式：python -c "import secrets;print(secrets.token_hex(32))"
# 未配置或过于简单时：默认打印告警并使用临时随机密钥（重启后登录态失效）；
# 若设置 REQUIRE_STRONG_SECRET_KEY=true，则直接拒绝启动。
SECRET_KEY=your-secret-key
# REQUIRE_STRONG_SECRET_KEY=true

# ============ 运行模式 ============
# 生产环境务必保持 false（true 会开启 Werkzeug 调试器，存在远程代码执行风险）
FLASK_DEBUG=false
LOG_LEVEL=INFO

# ============ 数据库配置 ============
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-database-password
DB_NAME=your-database-name
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=10

# ============ AI 配置 ============
AI_API_KEY=your-AI-api-key
# 可选：覆盖默认接口与模型
# AI_API_URL=https://api.agnes-ai.cn/v1/chat/completions
# AI_MODEL=agnes-2.5-flash
# AI_CONNECT_TIMEOUT=10
# AI_READ_TIMEOUT=120
# AI_STREAM_READ_TIMEOUT=180
# AI_ANSWER_MAX_TOKENS=16000
# 同一会话携带的历史消息条数与单条长度上限（控制上下文长度）
# AI_CONTEXT_MAX_MESSAGES=12
# AI_CONTEXT_MAX_CHARS=1500

# ============ 上传限制 ============
# 单次请求体上限（字节），默认 8MB
# MAX_CONTENT_LENGTH=8388608
# 单张图片上限（字节），默认 5MB
# MAX_IMAGE_SIZE=5242880
# 是否允许 AI 读取远程图片地址（默认关闭，开启存在 SSRF 风险）
# ALLOW_REMOTE_IMAGE_URL=false

# ============ 会话与登录安全 ============
# 仅 HTTPS 部署时设为 true
# SESSION_COOKIE_SECURE=false
# 登录态有效期（秒），默认 7 天
# PERMANENT_SESSION_LIFETIME=604800
# 连续登录失败次数上限与锁定时长（秒）
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=300
# 密码策略
# PASSWORD_MIN_LENGTH=8
# PASSWORD_MAX_LENGTH=72
